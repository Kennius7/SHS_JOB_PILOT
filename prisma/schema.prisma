generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent]
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  ADMIN
}

enum WorkArrangement {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  UNKNOWN
}

enum SalaryPeriod {
  YEAR
  MONTH
  DAY
  HOUR
}

enum NigerianState {
  ABIA
  ADAMAWA
  AKWA_IBOM
  ANAMBRA
  BAUCHI
  BAYELSA
  BENUE
  BORNO
  CROSS_RIVER
  DELTA
  EBONYI
  EDO
  EKITI
  ENUGU
  FCT
  GOMBE
  IMO
  JIGAWA
  KADUNA
  KANO
  KATSINA
  KEBBI
  KOGI
  KWARA
  LAGOS
  NASARAWA
  NIGER
  OGUN
  ONDO
  OSUN
  OYO
  PLATEAU
  RIVERS
  SOKOTO
  TARABA
  YOBE
  ZAMFARA
  UNKNOWN
}

enum ApplicationState {
  DISCOVERED
  MATCHED
  ELIGIBILITY_CHECKED
  DRAFT_PREPARED
  AWAITING_APPROVAL
  QUEUED
  SUBMITTING
  SUBMITTED
  CONFIRMED
  SKIPPED
  NEEDS_USER_INPUT
  MANUAL_APPLICATION_REQUIRED
  FAILED
  UNKNOWN_OUTCOME
}

enum DocumentKind {
  CV
  COVER_LETTER
  CERTIFICATE
  OTHER
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  NEEDS_OCR
}

enum ProviderAccessMode {
  PUBLIC_API
  AUTHORIZED_API
  APPROVED_FEED
  PERMITTED_BROWSER
  MANUAL_LINK_ONLY
}

enum JobStatus {
  ACTIVE
  EXPIRED
  REMOVED
  DUPLICATE
  STALE
}

enum AttemptOutcome {
  IN_PROGRESS
  ACCEPTED
  REJECTED
  NEEDS_INPUT
  RATE_LIMITED
  NETWORK_ERROR
  UNKNOWN
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(USER)
  emailVerified DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  profile            UserProfile?
  sessions           UserSession[]
  documents          Document[]
  applications       Application[]
  savedJobs          SavedJob[]
  rules              ApplicationRule[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  usageRecords       UsageRecord[]
  verificationTokens VerificationToken[]

  @@index([email])
  @@index([deletedAt])
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  type      VerificationTokenType
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model UserSession {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// CAREER PROFILE
// ============================================================

model UserProfile {
  id                    String         @id @default(cuid())
  userId                String         @unique
  fullName              String?
  phone                 String?
  country               String?
  state                 NigerianState?
  city                  String?
  workAuthorized        Boolean        @default(true)
  needsSponsorship      Boolean        @default(false)
  currentRole           String?
  targetRoles           String[]
  yearsExperience       Int?
  noticePeriod          String?
  availability          String?
  linkedinUrl           String?
  githubUrl             String?
  portfolioUrl          String?
  websiteUrl            String?
  summary               String?
  version               Int            @default(1)
  onboardingStep        String?        @default("welcome")
  onboardingCompletedAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiences Experience[]
  education   Education[]
  skills      UserSkill[]
  preferences CareerPreference?
  languages   UserLanguage[]

  @@index([country, state])
}

model Experience {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  employer    String
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  highlights  String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Education {
  id          String    @id @default(cuid())
  profileId   String
  institution String
  degree      String?
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id       String      @id @default(cuid())
  name     String      @unique
  category String?
  users    UserSkill[]
  jobs     JobSkill[]

  @@index([name])
}

model UserSkill {
  id        String   @id @default(cuid())
  profileId String
  skillId   String
  level     Int?
  yearsUsed Int?
  createdAt DateTime @default(now())

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
}

model UserLanguage {
  id          String @id @default(cuid())
  profileId   String
  language    String
  proficiency String?

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, language])
}

model CareerPreference {
  id                     String           @id @default(cuid())
  profileId              String           @unique
  preferredStates        NigerianState[]
  remoteOnly             Boolean          @default(false)
  hybridAllowed          Boolean          @default(true)
  onsiteAllowed          Boolean          @default(true)
  salaryFloor            Int?
  salaryCurrency         String           @default("NGN")
  employmentTypes        EmploymentType[]
  preferredIndustries    String[]
  excludedIndustries     String[]
  excludedCompanies      String[]
  maxApplicationsPerDay  Int              @default(10)
  maxApplicationsPerWeek Int              @default(50)
  minMatchScore          Int              @default(70)
  autoSubmitEnabled      Boolean          @default(false)
  coverLetterAutoGen     Boolean          @default(true)
  cvTailoringAllowed     Boolean          @default(false)
  reviewOnMissingRequired Boolean         @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  profile UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id               String           @id @default(cuid())
  userId           String
  kind             DocumentKind
  originalName     String
  storageKey       String           @unique
  mimeType         String
  sizeBytes        Int
  sha256           String
  fileHash         String           @unique
  extractedText    String?
  parsedData       Json?
  extractionStatus ExtractionStatus @default(PENDING)
  extractionError  String?
  extractedAt      DateTime?
  createdAt        DateTime         @default(now())
  deletedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([sha256])
}

// ============================================================
// PROVIDERS
// ============================================================

model JobProvider {
  key          String             @id
  displayName  String
  accessMode   ProviderAccessMode
  capabilities Json
  enabled      Boolean            @default(false)
  configured   Boolean            @default(false)
  healthy      Boolean            @default(false)
  lastSyncAt   DateTime?
  lastError    String?
  lastErrorAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  syncRuns ProviderSyncRun[]
  jobs     Job[]
}

model ProviderSyncRun {
  id            String    @id @default(cuid())
  providerKey   String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String
  jobsFound     Int       @default(0)
  jobsNew       Int       @default(0)
  jobsDuplicate Int       @default(0)
  jobsRejected  Int       @default(0)
  errorMessage  String?
  metadata      Json?

  provider JobProvider @relation(fields: [providerKey], references: [key], onDelete: Cascade)

  @@index([providerKey, startedAt])
}

// ============================================================
// JOBS
// ============================================================

model Job {
  id                String          @id @default(cuid())
  providerKey       String
  externalId        String
  title             String
  employer          String
  description       String?
  country           String          @default("NG")
  state             NigerianState?
  city              String?
  workArrangement   WorkArrangement @default(UNKNOWN)
  employmentType    EmploymentType  @default(UNKNOWN)
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?         @default("NGN")
  salaryPeriod      SalaryPeriod?
  requiredSkills    String[]
  preferredSkills   String[]
  experienceYears   Int?
  educationReq      String?
  seniority         String?
  publishedAt       DateTime?
  closingAt         DateTime?
  sourceUrl         String
  applyUrl          String?
  firstSeenAt       DateTime        @default(now())
  lastSeenAt        DateTime        @default(now())
  lastVerifiedAt    DateTime?
  status            JobStatus       @default(ACTIVE)
  canonicalKey      String          @unique
  attribution       String?
  usageRestrictions String[]
  discoveredBy      String          @default("provider-sync")
  rawPayload        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  provider     JobProvider   @relation(fields: [providerKey], references: [key], onDelete: Cascade)
  skills       JobSkill[]
  savedBy      SavedJob[]
  matches      JobMatch[]
  applications Application[]

  @@unique([providerKey, externalId])
  @@index([title])
  @@index([state, workArrangement])
  @@index([country, state])
  @@index([employer])
  @@index([status, publishedAt])
  @@index([salaryCurrency, salaryMin])
}

model JobSkill {
  id      String @id @default(cuid())
  jobId   String
  skillId String
  type    String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

// ============================================================
// MATCHING & RULES
// ============================================================

model JobMatch {
  id                  String   @id @default(cuid())
  userId              String
  jobId               String
  overallScore        Float
  breakdown           Json
  missingRequired     String[]
  reasons             String[]
  hardEligibilityFail Boolean  @default(false)
  profileVersion      Int
  modelVersion        String?
  promptVersion       String?
  createdAt           DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, overallScore])
  @@index([userId, profileVersion])
}

model ApplicationRule {
  id         String   @id @default(cuid())
  userId     String
  name       String
  isActive   Boolean  @default(true)
  version    Int      @default(1)
  conditions Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations RuleEvaluation[]

  @@index([userId, isActive])
}

model RuleEvaluation {
  id             String   @id @default(cuid())
  ruleId         String
  jobId          String
  profileVersion Int
  ruleVersion    Int
  result         String
  reasons        String[]
  createdAt      DateTime @default(now())

  rule ApplicationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, result])
  @@index([jobId])
}

// ============================================================
// APPLICATIONS
// ============================================================

model Application {
  id                   String           @id @default(cuid())
  userId               String
  jobId                String
  state                ApplicationState @default(DISCOVERED)
  matchScore           Float?
  ruleEvalJson         Json?
  attemptCount         Int              @default(0)
  maxAttempts          Int              @default(3)
  providerRefId        String?
  confirmationEvidence Json?
  lastError            String?
  lastErrorAt          DateTime?
  idempotencyKey       String           @unique
  submittedAt          DateTime?
  confirmedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job                      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  materials ApplicationMaterial[]
  events    ApplicationStatusEvent[]
  attempts  ApplicationAttempt[]

  @@unique([userId, jobId])
  @@index([userId, state])
  @@index([state, createdAt])
}

model ApplicationAttempt {
  id             String         @id @default(cuid())
  applicationId  String
  attemptNumber  Int
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  outcome        AttemptOutcome @default(IN_PROGRESS)
  providerRefId  String?
  responseData   Json?
  errorCode      String?
  errorMessage   String?
  idempotencyKey String

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, attemptNumber])
  @@index([applicationId, startedAt])
  @@index([idempotencyKey])
}

model ApplicationMaterial {
  id            String   @id @default(cuid())
  applicationId String
  kind          String
  content       String?
  documentId    String?
  version       Int      @default(1)
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, kind])
}

model ApplicationStatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  fromState     ApplicationState?
  toState       ApplicationState
  note          String?
  metadata      Json?
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

// ============================================================
// NOTIFICATIONS, AUDIT, USAGE
// ============================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  amount    Float
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
