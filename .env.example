# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---- Database ----
DATABASE_URL=postgresql://shs:shs@localhost:5432/shs_job_pilot?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-48-byte-random-string
SESSION_SECRET=replace-me-with-48-byte-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---- AI (Gemini) ----
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_MOCK_MODE=true
AI_MONTHLY_BUDGET_USD=25
AI_PER_USER_MONTHLY_BUDGET_USD=2

# ---- Documents ----
DOCUMENT_STORAGE_PATH=./.data/documents
MAX_UPLOAD_SIZE_MB=10

# ---- Email ----
# EMAIL_PROVIDER: console | smtp | none  (console logs messages to stdout for dev)
EMAIL_PROVIDER=console
EMAIL_FROM="SHS Job Pilot <no-reply@shs-job-pilot.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Providers ----
# Adzuna (API key required; https://developer.adzuna.com/)
PROVIDER_ADZUNA_ENABLED=true
PROVIDER_ADZUNA_APP_ID=
PROVIDER_ADZUNA_APP_KEY=
PROVIDER_ADZUNA_COUNTRY=ng

# Jooble (API key required; https://jooble.org/api)
PROVIDER_JOOBLE_ENABLED=true
PROVIDER_JOOBLE_API_KEY=
PROVIDER_JOOBLE_COUNTRY=ng

# USAJOBS (API key + your email; https://developer.usajobs.gov/)
PROVIDER_USAJOBS_ENABLED=true
PROVIDER_USAJOBS_API_KEY=
PROVIDER_USAJOBS_EMAIL=

# Remotive (public API, no key)
PROVIDER_REMOTIVE_ENABLED=true

# Remote OK (public API, no key)
PROVIDER_REMOTEOK_ENABLED=true

# Employer job boards — public ATS APIs, configured with the board slug only.
# Disabled (not registered) until a slug is provided.
PROVIDER_GREENHOUSE_ENABLED=true
PROVIDER_GREENHOUSE_BOARD=
PROVIDER_LEVER_ENABLED=true
PROVIDER_LEVER_COMPANY=
PROVIDER_ASHBY_ENABLED=true
PROVIDER_ASHBY_ORG=

# ---- Registry (production only) ----
GITHUB_CONTAINER_REGISTRY=ghcr.io/YOUR_GITHUB_USERNAME/shs-job-pilot
IMAGE_TAG=dev
