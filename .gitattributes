# Prisma hashes the raw bytes of each migration file to record its checksum.
# Force LF for migrations so Windows checkouts match Linux CI / production and
# `prisma migrate deploy` never sees a spurious checksum change.
prisma/migrations/**/*.sql text eol=lf

# Shell scripts must keep LF to run on Linux.
*.sh text eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
